{{ 'siesta-co.css' | asset_url | stylesheet_tag }}

<div class="sc-confianza color-{{ section.settings.color_scheme }} gradient">
  <ul class="sc-confianza__lista page-width" role="list">
    {%- for block in section.blocks -%}
      <li class="sc-confianza__item" {{ block.shopify_attributes }}>
        <span class="sc-confianza__icono" aria-hidden="true">
          {%- case block.settings.icono -%}
            {%- when 'envio' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.5"/><circle cx="17" cy="17.5" r="1.5"/></svg>
            {%- when 'devolucion' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12a8 8 0 1 0 2.3-5.6"/><path d="M4 4v4h4"/></svg>
            {%- when 'pago' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
            {%- when 'luna' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg>
          {%- endcase -%}
        </span>
        <span class="sc-confianza__texto">
          <strong>{{ block.settings.titulo }}</strong>
          {%- if block.settings.subtitulo != blank -%}
            <span>{{ block.settings.subtitulo }}</span>
          {%- endif -%}
        </span>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "SC · Barra de confianza",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Garantía",
      "settings": [
        {
          "type": "select",
          "id": "icono",
          "label": "Icono",
          "options": [
            { "value": "envio", "label": "Envío" },
            { "value": "devolucion", "label": "Devolución" },
            { "value": "pago", "label": "Pago seguro" },
            { "value": "luna", "label": "Luna" }
          ],
          "default": "envio"
        },
        { "type": "text", "id": "titulo", "label": "Título", "default": "Envío gratis desde 35 €" },
        { "type": "text", "id": "subtitulo", "label": "Subtítulo", "default": "2–5 días laborables" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SC · Barra de confianza",
      "blocks": [
        { "type": "item", "settings": { "icono": "envio", "titulo": "Envío gratis desde 35 €", "subtitulo": "2–5 días desde la UE" } },
        { "type": "item", "settings": { "icono": "devolucion", "titulo": "30 días para devolverlo", "subtitulo": "Sin preguntas" } },
        { "type": "item", "settings": { "icono": "pago", "titulo": "Pago 100 % seguro", "subtitulo": "Tarjeta, Apple Pay, PayPal" } },
        { "type": "item", "settings": { "icono": "luna", "titulo": "Probado por nosotros", "subtitulo": "Solo vendemos lo que usamos" } }
      ]
    }
  ]
}
{% endschema %}
